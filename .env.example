# Copy this file to ".env" (same folder) and fill in your key. ".env" is git-ignored.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# UPLOAD_PORT=COM4

# --- Automatic tests on the board (server.py / generate.py --test) ---
# TESTS=0                  # flash without running the tests
# Camera that sees the screen; find it with: python tools/ui_generator/camera_check.py
# Without CAMERA_INDEX the tests still run, but without photos.
# CAMERA_INDEX=1
# CAMERA_CROP=400,120,480,560   # optional x,y,w,h in camera pixels: just the screen
# CAMERA_ROTATE=0               # optional 0/90/180/270, clockwise
# CAMERA_RESOLUTION=1600x1200  # 4:3 sees more than 16:9; CAMERA_CROP is in these pixels
# GEMINI_JUDGE_MODEL=gemini-2.5-flash   # optional separate model for the photo checks
# GEMINI_JUDGE_API_KEY=          # separate (e.g. paid) key for the photo checks; defaults to GEMINI_API_KEY
# GEMINI_JUDGE_FALLBACK_MODEL=   # optional second judge model; none by default with a separate key

# --- Which AI writes the UI and its tests ---
# GENERATOR_PROVIDER=gemini     # or openai
# OPENAI_API_KEY=
# OPENAI_MODEL=                 # e.g. a current GPT model id
